{
  "name": "Gestor Familiar",
  "short_name": "Finanzas",
  "description": "Finanzas familiares privadas y cifradas a partir del Excel del banco",
  "lang": "es",
  "start_url": "./#/resumen",
  "scope": "./",
  "display": "standalone",
  "background_color": "#111210",
  "theme_color": "#111210",
  "icons": [
    { "src": "iconos/icono-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "iconos/icono-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "iconos/icono-mascara-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./compartir",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [{ "name": "archivo", "accept": [".xlsx", ".csv", "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", "text/csv"] }]
    }
  }
}
